# Copy to .env for local development, and set the same variables in each Vercel project
# (Project → Settings → Environment Variables). NEXT_PUBLIC_* values are baked in at build
# time, so redeploy after changing them.

# --- Required ---
# Display name used in titles, footer, and the installed app name
NEXT_PUBLIC_WARD_NAME="Sycamores 4th Ward"
# Ward identifier on the Latter Day Ward API (e.g. /api/datacard/<LDW_WARD_PATH>)
LDW_WARD_PATH=sycamores4th
# Latter Day Ward API key for this ward (secret)
LDW_KEY=

# --- Optional ---
# "Back to Stake Site" links. Leave unset on the stake site itself.
NEXT_PUBLIC_STAKE_URL=https://www.sycamoresstake.com
# Google Tag Manager container ID. Leave unset to disable analytics.
NEXT_PUBLIC_GTM_ID=
# Pin the home page hero to a specific data card ID (defaults to the first "hero-card")
LDW_HERO_CARD_ID=
# Override the API base URL
LDW_API_URL=https://api.latterdayward.com/api
